# Cloudflare : en-têtes de sécurité (le site ne contient aucune donnée).
# Seul hôte joignable depuis l'appli (connect-src) : api.github.com (données du dépôt privé).
/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://api.github.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
